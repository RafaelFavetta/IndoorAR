<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    tools:context="com.example.indoorar.ActivityCadastrarMapa">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Top bar -->
        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/ripple_clickable"
            android:contentDescription="Voltar"
            android:padding="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_avancar_azul"
            android:rotation="180"/>

        <!-- Image picker -->

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/staatliches"
            android:text="Cadastrar mapa"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toEndOf="@id/btnVoltar"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardImagem"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:layout_marginTop="20dp"
            app:cardElevation="8dp"
            app:cardCornerRadius="0dp"
            app:cardPreventCornerOverlap="false"
            app:cardUseCompatPadding="false"
            app:layout_constraintTop_toBottomOf="@id/txtTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent">

                <ImageView
                    android:id="@+id/imgPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="Pré-visualização da imagem"
                    android:background="@android:color/transparent"
                    android:src="@drawable/bg_user_image" />

                <TextView
                    android:id="@+id/txtHintImagem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toque para escolher uma imagem do local"
                    android:textColor="#8832357A"
                    android:textStyle="normal"
                    android:padding="8dp"
                    android:background="@android:color/transparent"
                    android:layout_gravity="center"/>
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Nome do Local -->
        <EditText
            android:id="@+id/editNomeLocal"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:autofillHints=""
            android:background="@drawable/btn_arredondado3"
            android:elevation="4dp"
            android:fontFamily="@font/inter"
            android:hint="Nome do local"
            android:inputType="text"
            android:minHeight="48dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#121212"
            android:textColorHint="#80121212"
            android:textSize="18sp"
            android:textStyle="normal"
            app:layout_constraintTop_toBottomOf="@id/cardImagem"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"/>

        <!-- Descrição do Local -->
        <EditText
            android:id="@+id/editDescricaoLocal"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:autofillHints=""
            android:background="@drawable/btn_arredondado3"
            android:elevation="4dp"
            android:fontFamily="@font/inter"
            android:hint="Descrição do local"
            android:inputType="textMultiLine"
            android:minLines="4"
            android:maxLines="8"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#121212"
            android:textColorHint="#80121212"
            android:textSize="18sp"
            android:textStyle="normal"
            app:layout_constraintTop_toBottomOf="@id/editNomeLocal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"/>

        <!-- Andar / Nível do Local -->
        <EditText
            android:id="@+id/editAndarLocal"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:autofillHints=""
            android:background="@drawable/btn_arredondado3"
            android:elevation="4dp"
            android:fontFamily="@font/inter"
            android:hint="Quantidade de andares"
            android:inputType="number"
            android:minHeight="48dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="#121212"
            android:textColorHint="#80121212"
            android:textSize="18sp"
            android:textStyle="normal"
            app:layout_constraintTop_toBottomOf="@id/editDescricaoLocal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp"/>

        <!-- Botão Salvar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvarLocal"
            android:layout_width="260dp"
            android:layout_height="72dp"
            android:layout_marginTop="40dp"
            android:text="Salvar mapa"
            android:textStyle="bold"
            android:textSize="21sp"
            app:icon="@drawable/ic_addmapa"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:cornerRadius="36dp"
            app:strokeColor="#32357A"
            app:strokeWidth="0dp"
            android:backgroundTint="#32357A"
            app:layout_constraintTop_toBottomOf="@id/editAndarLocal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <ProgressBar
            android:id="@+id/progressSalvar"
            style="@android:style/Widget.Material.ProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btnSalvarLocal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>