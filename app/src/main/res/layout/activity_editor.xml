<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".ui.ActivityEditor">

    <com.example.indoorar.ui.editor.MapEditorView
        android:id="@+id/mapEditor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:background="#EAEAEA"
        tools:layout_editor_absoluteX="1dp" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="350dp"
            android:layout_height="35dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#fdfdfd"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/linearcursor"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.25"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/cursor"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:padding="4dp"
                        app:tint="@color/icon_tint_selector"
                        app:srcCompat="@drawable/ic_cursor_azul"
                         />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linearformas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.25"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/formas"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:padding="3dp"
                        app:tint="@color/icon_tint_selector"
                        app:srcCompat="@drawable/ic_square_azul" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linearbrush"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.25"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/brush"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        app:tint="@color/icon_tint_selector"
                        app:srcCompat="@drawable/ic_brush" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linearpoi"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.25"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/poi"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        app:srcCompat="@drawable/ic_poi"
                        app:tint="@color/icon_tint_selector" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linearlayers"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.25"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/layers"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        app:tint="@color/icon_tint_selector"
                        app:srcCompat="@drawable/ic_layers" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lineardesfazer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.25"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/desfazer"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        app:tint="@color/icon_tint_selector"
                        app:srcCompat="@drawable/ic_desfazer" />
                </LinearLayout>

            </LinearLayout>



        </com.google.android.material.card.MaterialCardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/painelAtributos"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="3dp"
            app:cardElevation="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Nome -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_name"
                        android:drawablePadding="6dp"
                        android:text="Nome"
                        android:textColor="#444"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/inputNome"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="12dp"
                        android:background="#F5F5F5"
                        android:padding="8dp"
                        android:hint="Insira um nome"
                        android:textColor="#000000"
                        android:textColorHint="#999999"
                        android:textSize="13sp" />

                    <!-- Linha separadora -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginBottom="12dp" />

                    <!-- Posição -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_posicao"
                        android:drawablePadding="6dp"
                        android:text="Posição"
                        android:textColor="#444"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="X"
                                android:textColor="#444"
                                android:textSize="11sp"
                                android:layout_marginBottom="2dp" />

                            <EditText
                                android:id="@+id/inputX"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="#F5F5F5"
                                android:gravity="center"
                                android:hint="X"
                                android:inputType="numberDecimal"
                                android:textColor="#000000"
                                android:textColorHint="#999999"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Y"
                                android:textColor="#444"
                                android:textSize="11sp"
                                android:layout_marginBottom="2dp" />

                            <EditText
                                android:id="@+id/inputY"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="#F5F5F5"
                                android:gravity="center"
                                android:hint="Y"
                                android:inputType="numberDecimal"
                                android:textColor="#000000"
                                android:textColorHint="#999999"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Linha separadora -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginBottom="12dp" />

                    <!-- Dimensões -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_dimensoes"
                        android:drawablePadding="6dp"
                        android:text="Dimensões"
                        android:textColor="#444"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Largura"
                                android:textColor="#444"
                                android:textSize="11sp"
                                android:layout_marginBottom="2dp" />

                            <EditText
                                android:id="@+id/inputWidth"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="#F5F5F5"
                                android:gravity="center"
                                android:hint="Largura"
                                android:inputType="numberDecimal"
                                android:textColor="#000000"
                                android:textColorHint="#999999"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Altura"
                                android:textColor="#444"
                                android:textSize="11sp"
                                android:layout_marginBottom="2dp" />

                            <EditText
                                android:id="@+id/inputHeight"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="#F5F5F5"
                                android:gravity="center"
                                android:hint="Altura"
                                android:inputType="numberDecimal"
                                android:textColor="#000000"
                                android:textColorHint="#999999"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Linha separadora -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginBottom="12dp" />

                    <!-- Rotação -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_rotate"
                        android:drawablePadding="6dp"
                        android:text="Rotação"
                        android:textColor="#444"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <EditText
                        android:id="@+id/inputRotation"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="12dp"
                        android:background="#F5F5F5"
                        android:gravity="center"
                        android:hint="0°"
                        android:inputType="numberDecimal"
                        android:textColor="#000000"
                        android:textColorHint="#999999"
                        android:textSize="13sp" />

                    <!-- Linha separadora -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginBottom="12dp" />

                    <!-- Cor -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_palette2"
                        android:drawablePadding="6dp"
                        android:text="Cor"
                        android:textColor="#444"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <ImageView
                            android:id="@+id/colorPreview"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginEnd="6dp"
                            android:background="#F5F5F5" />

                        <EditText
                            android:id="@+id/inputHex"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="2"
                            android:background="#F5F5F5"
                            android:gravity="center"
                            android:hint="#FFFFFF"
                            android:inputType="text"
                            android:textColor="#000000"
                            android:textColorHint="#999999"
                            android:textSize="13sp" />

                        <ImageButton
                            android:id="@+id/btnColorPicker"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:backgroundTint="@android:color/transparent"
                            android:contentDescription="Selecionar cor"
                            app:srcCompat="@drawable/ic_fill" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>
        </androidx.cardview.widget.CardView>



    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>