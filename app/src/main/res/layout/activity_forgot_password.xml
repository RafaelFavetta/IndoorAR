<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fdfdfd">

    <TextView
        android:id="@+id/tvForgotTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recuperar Senha"
        android:textSize="32sp"
        android:textColor="#32357A"
        android:fontFamily="@font/staatliches"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp"/>

    <TextView
        android:id="@+id/tvForgotSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Digite seu e-mail cadastrado e enviaremos um link para redefinir sua senha."
        android:textColor="#828385"
        android:textSize="16sp"
        android:fontFamily="@font/inter"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/tvForgotTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"/>

    <EditText
        android:id="@+id/etForgotEmail"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Digite seu e-mail"
        android:inputType="textEmailAddress"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/btn_arredondado3"
        android:textColor="#121212"
        android:textColorHint="#80121212"
        android:fontFamily="@font/inter"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvForgotSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:elevation="3dp"/>

    <Button
        android:id="@+id/btnResetPassword"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="Enviar link de recuperação"
        android:textAllCaps="false"
        android:textColor="#fdfdfd"
        android:textSize="18sp"
        android:fontFamily="@font/staatliches"
        android:background="@drawable/btn_arredondado"
        android:backgroundTint="#32357A"
        android:elevation="5dp"
        app:layout_constraintTop_toBottomOf="@id/etForgotEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"/>

    <TextView
        android:id="@+id/tvBackToLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Voltar para login"
        android:textColor="#32357A"
        android:textSize="16sp"
        android:fontFamily="@font/inter"
        android:textStyle="normal"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/btnResetPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>