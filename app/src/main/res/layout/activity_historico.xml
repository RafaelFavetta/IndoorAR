<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity_historico">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#32357A"
                android:orientation="vertical"
                android:paddingTop="40dp"
                android:paddingBottom="16dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp">

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="36dp"
                    android:layout_height="46dp"
                    android:contentDescription="logo"
                    app:srcCompat="@drawable/logo_branca"/>

                <TextView
                    android:id="@+id/txtHistorico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:fontFamily="@font/inter"
                    android:textColor="#fdfdfd"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:text="Histórico de Visitas"/>

                <EditText
                    android:id="@+id/editSearch"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:drawablePadding="16dp"
                    android:padding="16dp"
                    android:drawableStart="@drawable/search"
                    android:drawableEnd="@drawable/microphone"
                    android:background="@drawable/editext_background"
                    android:inputType="text"
                    android:hint="Procurar..."
                    android:textColor="#FDFDFD"
                    android:textColorHint="#fdfdfd"/>
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/arcBackground"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/arc_2" />

                <LinearLayout
                    android:id="@+id/listHistorico"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="50dp"
                    tools:ignore="MissingConstraints">

                    <androidx.cardview.widget.CardView
                        android:layout_width="350dp"
                        android:layout_height="100dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="4dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp">

                            <ImageView
                                android:id="@+id/imgLeft1"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:contentDescription="Ícone do local"
                                android:src="@drawable/bottom_btn1" />

                            <ImageView
                                android:id="@+id/imgRight1"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/favoriteblue"
                                android:contentDescription="Ícone Favorito"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_toEndOf="@id/imgLeft1"
                                android:layout_toStartOf="@id/imgRight1"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp">

                                <TextView
                                    android:id="@+id/txtLocal1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Local 1"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:ellipsize="end"
                                    android:singleLine="true"/>

                                <TextView
                                    android:id="@+id/txtDataHora1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="12/09/2025 14:30"
                                    android:textSize="14sp"
                                    android:textColor="#888888"
                                    android:ellipsize="end"
                                    android:singleLine="true"/>
                            </LinearLayout>
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="350dp"
                        android:layout_height="100dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="4dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp">

                            <ImageView
                                android:id="@+id/imgLeft2"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:contentDescription="Ícone do local"
                                android:src="@drawable/bottom_btn1" />

                            <ImageView
                                android:id="@+id/imgRight2"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/favoriteblue"
                                android:contentDescription="Ícone Favorito"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_toEndOf="@id/imgLeft2"
                                android:layout_toStartOf="@id/imgRight2"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp">

                                <TextView
                                    android:id="@+id/txtLocal2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Local 2"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:ellipsize="end"
                                    android:singleLine="true"/>

                                <TextView
                                    android:id="@+id/txtDataHora2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="11/09/2025 10:00"
                                    android:textSize="14sp"
                                    android:textColor="#888888"
                                    android:ellipsize="end"
                                    android:singleLine="true"/>
                            </LinearLayout>
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="350dp"
                        android:layout_height="100dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="4dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp">

                            <ImageView
                                android:id="@+id/imgLeft3"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:contentDescription="Ícone do local"
                                android:src="@drawable/bottom_btn1" />

                            <ImageView
                                android:id="@+id/imgRight3"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/favoriteblue"
                                android:contentDescription="Ícone Favorito"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_toEndOf="@id/imgLeft3"
                                android:layout_toStartOf="@id/imgRight3"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp">

                                <TextView
                                    android:id="@+id/txtLocal3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Local 3"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:ellipsize="end"
                                    android:singleLine="true"/>

                                <TextView
                                    android:id="@+id/txtDataHora3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="10/09/2025 14:00"
                                    android:textSize="14sp"
                                    android:textColor="#888888"
                                    android:ellipsize="end"
                                    android:singleLine="true"/>
                            </LinearLayout>
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="350dp"
                        android:layout_height="100dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="4dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp">

                            <ImageView
                                android:id="@+id/imgLeft4"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:contentDescription="Ícone do local"
                                android:src="@drawable/bottom_btn1" />

                            <ImageView
                                android:id="@+id/imgRight4"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/favoriteblue"
                                android:contentDescription="Ícone Favorito"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_toEndOf="@id/imgLeft4"
                                android:layout_toStartOf="@id/imgRight4"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp">

                                <TextView
                                    android:id="@+id/txtLocal4"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Local 4"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:ellipsize="end"
                                    android:singleLine="true"/>

                                <TextView
                                    android:id="@+id/txtDataHora4"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="09/09/2025 09:30"
                                    android:textSize="14sp"
                                    android:textColor="#888888"
                                    android:ellipsize="end"
                                    android:singleLine="true"/>
                            </LinearLayout>
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="350dp"
                        android:layout_height="100dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="4dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp">

                            <ImageView
                                android:id="@+id/imgLeft5"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:contentDescription="Ícone do local"
                                android:src="@drawable/bottom_btn1" />

                            <ImageView
                                android:id="@+id/imgRight5"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/favoriteblue"
                                android:contentDescription="Ícone Favorito"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_toEndOf="@id/imgLeft5"
                                android:layout_toStartOf="@id/imgRight5"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp">

                                <TextView
                                    android:id="@+id/txtLocal5"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Local 5"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:ellipsize="end"
                                    android:singleLine="true"/>

                                <TextView
                                    android:id="@+id/txtDataHora5"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="08/09/2025 15:45"
                                    android:textSize="14sp"
                                    android:textColor="#888888"
                                    android:ellipsize="end"
                                    android:singleLine="true"/>
                            </LinearLayout>
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="350dp"
                        android:layout_height="100dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="4dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="12dp">

                            <ImageView
                                android:id="@+id/imgLeft6"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:contentDescription="Ícone do local"
                                android:src="@drawable/bottom_btn1" />

                            <ImageView
                                android:id="@+id/imgRight6"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/favoriteblue"
                                android:contentDescription="Ícone Favorito"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_toEndOf="@id/imgLeft6"
                                android:layout_toStartOf="@id/imgRight6"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="16dp">

                                <TextView
                                    android:id="@+id/txtLocal6"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Local 6"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:ellipsize="end"
                                    android:singleLine="true"/>

                                <TextView
                                    android:id="@+id/txtDataHora6"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="07/09/2025 11:15"
                                    android:textSize="14sp"
                                    android:textColor="#888888"
                                    android:ellipsize="end"
                                    android:singleLine="true"/>
                            </LinearLayout>
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
