<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Preview da câmera ocupando toda a tela -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Texto opcional de instrução -->
    <TextView
        android:id="@+id/instructionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="12dp"
        android:background="#66000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- Seta da navegação sobreposta, centralizada por padrão -->
    <ImageView
        android:id="@+id/arrowView"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_nav_arrow"
        android:contentDescription="@string/app_name"
        app:tint="#FFFFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Botão: escolher destino -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEscolherDestino"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ESCOLHER DESTINO"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botão: limpar rota -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLimparRota"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LIMPAR ROTA"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnEscolherDestino"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Distância até o destino -->
    <TextView
        android:id="@+id/tvDistancia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Distância: --"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:padding="8dp"
        android:background="#66000000"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnLimparRota"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Minimap no canto inferior direito -->
    <com.example.indoorar.ui.MinimapView
        android:id="@+id/minimap"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="#99000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>