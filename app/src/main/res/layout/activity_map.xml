<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Preview da câmera ocupando toda a tela -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Texto opcional de instrução -->
    <TextView
        android:id="@+id/instructionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="12dp"
        android:background="#66000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- Seta da navegação sobreposta, centralizada por padrão -->
    <ImageView
        android:id="@+id/arrowView"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_nav_arrow"
        android:contentDescription="@string/app_name"
        app:tint="#FFFFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Botão: escolher destino -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEscolherDestino"
        android:layout_width="100dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="Escolher destino"
        android:textAllCaps="true"
        android:textSize="10sp"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Botão: limpar rota -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLimparRota"
        android:layout_width="100dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:text="Limpar rota"
        android:textAllCaps="true"
        android:textSize="10sp"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnEscolherDestino" />

    <!-- Distância até o destino -->
    <TextView
        android:id="@+id/tvDistancia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Distância: --"
        android:textColor="#FDFDFD"
        android:textSize="14sp"
        android:padding="8dp"
        android:background="#66000000"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnLimparRota"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Minimap no canto inferior direito -->
    <com.example.indoorar.ui.MinimapView
        android:id="@+id/minimap"
        android:layout_width="150dp"
        android:layout_height="150dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp" />

    <!-- Controles manuais de movimento (para debug/teste) -->
    <LinearLayout
        android:id="@+id/manualControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#99000000"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="16dp">

        <!-- Botão: Frente -->
        <Button
            android:id="@+id/btnMoveUp"
            android:layout_width="60dp"
            android:layout_height="48dp"
            android:text="↑"
            android:textSize="20sp"
            android:layout_gravity="center_horizontal" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Botão: Esquerda -->
            <Button
                android:id="@+id/btnMoveLeft"
                android:layout_width="60dp"
                android:layout_height="48dp"
                android:text="←"
                android:textSize="20sp" />

            <!-- Botão: Direita -->
            <Button
                android:id="@+id/btnMoveRight"
                android:layout_width="60dp"
                android:layout_height="48dp"
                android:text="→"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Botão: Trás -->
        <Button
            android:id="@+id/btnMoveDown"
            android:layout_width="60dp"
            android:layout_height="48dp"
            android:text="↓"
            android:textSize="20sp"
            android:layout_gravity="center_horizontal" />
    </LinearLayout>

    <!-- Botão pequeno para mostrar/ocultar os controles manuais -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnToggleManual"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:srcCompat="@drawable/ic_four_arrows"
        android:contentDescription="@string/mostrar_controles_manuais"
        android:background="@drawable/btn_arredondado_branco"
        android:tint="#32357A"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/manualControls"
        android:layout_marginStart="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>