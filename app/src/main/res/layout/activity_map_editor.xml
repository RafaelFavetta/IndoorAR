<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#fdfdfd">

    <!-- Sidebar esquerda com shapes -->
    <LinearLayout
        android:id="@+id/sidebarLeft"
        android:layout_width="50dp"
        android:layout_height="499dp"
        android:background="#32357A"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnAddRectangle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="□" />

        <Button
            android:id="@+id/btnAddCircle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="○" />

        <Button
            android:id="@+id/btnAddTriangule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="△" />

    </LinearLayout>

    <!-- Canvas central -->
    <com.example.indoorar.ui.MapCanvasView
        android:id="@+id/mapCanvas"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="#fdfdfd" />

    <!-- Sidebar direita (atributos do shape selecionado futuramente) -->
    <LinearLayout
        android:id="@+id/sidebarRight"
        android:layout_width="110dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#f5f5f5">

        <TextView
            android:id="@+id/txtShapeInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Atributos"
            android:textSize="16sp"
            android:padding="8dp" />

    </LinearLayout>

</LinearLayout>