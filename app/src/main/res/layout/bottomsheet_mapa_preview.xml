<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtTituloMapa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Título do mapa"
        android:textColor="#32357A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtDescricaoMapa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Descrição do mapa"
        android:textColor="#555"
        android:textSize="14sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_minimap_placeholder" />
    </com.google.android.material.card.MaterialCardView>

    <Button
        android:id="@+id/btnIniciarNavegacao"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/btn_arredondado"
        android:text="INICIAR NAVEGAÇÃO"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnBaixarQRCode"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_arredondado"
        android:text="BAIXAR QR CODE"
        android:textAllCaps="true"
        android:textColor="#FFFFFF" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDownloadQRCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <Button
                android:id="@+id/btnDownloadPDF"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_arredondado"
                android:text="baixar como PDF"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp" />
            <Button
                android:id="@+id/btnDownloadPNG"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_arredondado"
                android:text="baixar como PNG"
                android:textAllCaps="true"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
