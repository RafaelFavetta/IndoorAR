<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtTituloMapa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Título do mapa"
        android:textColor="#32357A"
        android:textSize="18sp"
        android:textStyle="normal" />

    <TextView
        android:id="@+id/txtDescricaoMapa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Descrição do mapa"
        android:textColor="#555"
        android:textSize="12.5sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp">

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_minimap_placeholder" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIniciarNavegacao"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="INICIAR NAVEGAÇÃO"
        android:textAllCaps="true"
        android:textColor="#FDFDFD"
        app:backgroundTint="#32357A"
        app:cornerRadius="30dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBaixarQRCode"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="BAIXAR QR CODE"
        android:textAllCaps="true"
        android:textStyle="normal"
        android:textColor="#FDFDFD"
        app:backgroundTint="#32357A"
        app:cornerRadius="30dp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDownloadQRCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardUseCompatPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadPDF"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="baixar como PDF"
                android:textAllCaps="true"
                android:textColor="#FDFDFD"
                android:layout_marginBottom="12dp"
                app:backgroundTint="#32357A"
                app:cornerRadius="30dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadPNG"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="baixar como PNG"
                android:textAllCaps="true"
                android:textColor="#FDFDFD"
                app:backgroundTint="#32357A"
                app:cornerRadius="30dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
