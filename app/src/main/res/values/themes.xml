<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base do app -->
    <style name="Theme.IndoorAR" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#32357A</item>
        <item name="colorPrimaryVariant">#32357A</item>
        <item name="colorOnPrimary">#FDFDFD</item>
        <item name="android:statusBarColor">#32357A</item>
        <item name="android:windowBackground">#FDFDFD</item>


        <!-- Splash screen API 31+ -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/colorOnPrimary</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@color/colorOnPrimary</item>
    </style>

    <!-- Splash para versões antigas -->
    <style name="Theme.IndoorAR.Splash" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/colorPrimary</item>
    </style>

</resources>